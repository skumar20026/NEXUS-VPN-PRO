name: Build NEXUS VPN PRO APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Generate Exact Reference UI NEXUS VPN Project
        run: |
          mkdir -p app/src/main/java/com/skumar/nexusvpn
          mkdir -p app/src/main/res/drawable
          mkdir -p app/src/main/res/layout

          if [ -f "icon.png" ]; then
            cp icon.png app/src/main/res/drawable/app_logo.png
          fi

          cat << 'EOF' > settings.gradle
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "NEXUS-VPN"
          include ':app'
          EOF

          cat << 'EOF' > build.gradle
          plugins {
              id 'com.android.application' version '8.2.2' apply false
          }
          EOF

          cat << 'EOF' > gradle.properties
          org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
          android.useAndroidX=true
          android.nonTransitiveRClass=true
          EOF

          cat << 'EOF' > app/build.gradle
          plugins {
              id 'com.android.application'
          }
          android {
              namespace 'com.skumar.nexusvpn'
              compileSdk 34
              defaultConfig {
                  applicationId "com.skumar.nexusvpn"
                  minSdk 24
                  targetSdk 34
                  versionCode 1
                  versionName "1.0"
              }
              buildTypes {
                  release {
                      minifyEnabled false
                  }
              }
              compileOptions {
                  sourceCompatibility JavaVersion.VERSION_17
                  targetCompatibility JavaVersion.VERSION_17
              }
          }
          dependencies {
              implementation 'androidx.appcompat:appcompat:1.6.1'
              implementation 'com.google.android.material:material:1.11.0'
          }
          EOF

          if [ -f "app/src/main/res/drawable/app_logo.png" ]; then
            ICON_ATTR='android:icon="@drawable/app_logo"'
          else
            ICON_ATTR=''
          fi

          cat << EOF > app/src/main/AndroidManifest.xml
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.INTERNET" />
              <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
              <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
              <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

              <application
                  android:allowBackup="true"
                  $ICON_ATTR
                  android:label="NEXUS VPN"
                  android:supportsRtl="true"
                  android:theme="@style/Theme.Material3.Dark.NoActionBar">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true"
                      android:screenOrientation="portrait">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
                  <service
                      android:name=".NexusVpnService"
                      android:permission="android.permission.BIND_VPN_SERVICE"
                      android:exported="false">
                      <intent-filter>
                          <action android:name="android.net.VpnService" />
                      </intent-filter>
                  </service>
              </application>
          </manifest>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_main_gradient.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android">
              <gradient
                  android:type="radial"
                  android:gradientRadius="420dp"
                  android:centerX="0.5"
                  android:centerY="0.52"
                  android:startColor="#0A3A5A"
                  android:centerColor="#071522"
                  android:endColor="#04070B" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_outer_halo.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
              <gradient
                  android:type="radial"
                  android:gradientRadius="140dp"
                  android:startColor="#6600C6FF"
                  android:centerColor="#260099FF"
                  android:endColor="#00000000" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_power_ring.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
              <solid android:color="#081C2C" />
              <stroke android:width="3dp" android:color="#00B4D8" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_power_core.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
              <gradient
                  android:angle="270"
                  android:startColor="#48CAE4"
                  android:centerColor="#0096C7"
                  android:endColor="#023E8A" />
              <stroke android:width="2dp" android:color="#90E0EF" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_glass_card.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
              <solid android:color="#CC0D131A" />
              <corners android:radius="20dp" />
              <stroke android:width="1dp" android:color="#263241" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_pill_capsule.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
              <solid android:color="#D90B1017" />
              <corners android:radius="40dp" />
              <stroke android:width="1dp" android:color="#232D3B" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_circle_icon.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
              <solid android:color="#15202B" />
              <stroke android:width="1dp" android:color="#273445" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/bg_circle_active.xml
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
              <solid android:color="#122B3B" />
              <stroke android:width="1.5dp" android:color="#00B4D8" />
          </shape>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/ic_shield_blue.xml
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              android:width="24dp" android:height="24dp"
              android:viewportWidth="24" android:viewportHeight="24">
              <path android:fillColor="#00B4D8"
                  android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-6.45 9,-12V5L12,1zM10,17l-4,-4l1.41,-1.41L10,14.17l6.59,-6.59L18,9L10,17z"/>
          </vector>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/ic_power_white.xml
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              android:width="44dp" android:height="44dp"
              android:viewportWidth="24" android:viewportHeight="24">
              <path android:fillColor="#FFFFFF"
                  android:pathData="M13,3h-2v10h2V3zM17.83,5.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87 -3.13,7 -7,7s-7,-3.13 -7,-7c0,-2.19 1.01,-4.14 2.58,-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9,-4.03 9,-9C21,9.26 19.77,6.82 17.83,5.17z"/>
          </vector>
          EOF

          cat << 'EOF' > app/src/main/res/drawable/ic_signal_bars.xml
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              android:width="22dp" android:height="16dp"
              android:viewportWidth="22" android:viewportHeight="16">
              <path android:fillColor="#00B4D8" android:pathData="M1,11h2.5v4H1z"/>
              <path android:fillColor="#00B4D8" android:pathData="M5.5,8.5H8V15H5.5z"/>
              <path android:fillColor="#00B4D8" android:pathData="M10,6h2.5v9H10z"/>
              <path android:fillColor="#00B4D8" android:pathData="M14.5,3.5H17V15h-2.5z"/>
              <path android:fillColor="#334155" android:pathData="M19,1h2.5v14H19z"/>
          </vector>
          EOF

          cat << 'EOF' > app/src/main/res/layout/activity_main.xml
          <?xml version="1.0" encoding="utf-8"?>
          <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@drawable/bg_main_gradient"
              android:paddingStart="20dp"
              android:paddingEnd="20dp"
              android:paddingTop="18dp"
              android:paddingBottom="18dp"
              android:gravity="center_horizontal">

              <!-- Top Header matching exact screenshot -->
              <RelativeLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                      <FrameLayout
                          android:layout_width="42dp"
                          android:layout_height="42dp"
                          android:background="@drawable/bg_circle_icon">
                          <ImageView
                              android:layout_width="22dp"
                              android:layout_height="22dp"
                              android:layout_gravity="center"
                              android:src="@drawable/ic_shield_blue" />
                      </FrameLayout>

                      <LinearLayout
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:orientation="vertical"
                          android:layout_marginStart="12dp">
                          <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Status Connection"
                              android:textColor="#64748B"
                              android:textSize="11sp" />
                          <TextView
                              android:id="@+id/tvStatus"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Disconnected"
                              android:textColor="#FFFFFF"
                              android:textSize="15sp"
                              android:textStyle="bold" />
                      </LinearLayout>
                  </LinearLayout>

                  <!-- Top Right Pill with Gear (Split Tunnel) & Gold Crown (AdBlock) -->
                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="42dp"
                      android:layout_alignParentEnd="true"
                      android:background="@drawable/bg_pill_capsule"
                      android:paddingStart="10dp"
                      android:paddingEnd="10dp"
                      android:gravity="center_vertical"
                      android:orientation="horizontal">

                      <TextView
                          android:id="@+id/btnSplitTunnel"
                          android:layout_width="30dp"
                          android:layout_height="30dp"
                          android:gravity="center"
                          android:text="⚙"
                          android:textColor="#94A3B8"
                          android:textSize="18sp" />

                      <TextView
                          android:id="@+id/btnAdBlock"
                          android:layout_width="32dp"
                          android:layout_height="30dp"
                          android:gravity="center"
                          android:text="👑"
                          android:textSize="17sp"
                          android:layout_marginStart="6dp" />
                  </LinearLayout>
              </RelativeLayout>

              <!-- Digital Timer matching 00.53.50 style -->
              <TextView
                  android:id="@+id/tvTimer"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="00.00.00"
                  android:textColor="#F8FAFC"
                  android:textSize="34sp"
                  android:textStyle="bold"
                  android:letterSpacing="0.06"
                  android:layout_marginTop="20dp" />

              <!-- Download & Upload Curved Dark Glass Cards -->
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:layout_marginTop="18dp"
                  android:weightSum="2">

                  <LinearLayout
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:background="@drawable/bg_glass_card"
                      android:padding="14dp"
                      android:layout_marginEnd="6dp"
                      android:orientation="vertical"
                      android:gravity="center">
                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="Download"
                          android:textColor="#64748B"
                          android:textSize="12sp" />
                      <LinearLayout
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:gravity="center_vertical"
                          android:layout_marginTop="6dp">
                          <TextView
                              android:layout_width="22dp"
                              android:layout_height="22dp"
                              android:background="@drawable/bg_circle_icon"
                              android:gravity="center"
                              android:text="↓"
                              android:textColor="#00B4D8"
                              android:textSize="13sp"
                              android:textStyle="bold" />
                          <TextView
                              android:id="@+id/tvDownloadSpeed"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="0.00"
                              android:textColor="#FFFFFF"
                              android:textSize="20sp"
                              android:textStyle="bold"
                              android:layout_marginStart="6dp" />
                          <TextView
                              android:id="@+id/tvDownloadUnit"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text=" KB/S"
                              android:textColor="#64748B"
                              android:textSize="10sp"
                              android:layout_marginTop="3dp" />
                      </LinearLayout>
                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:background="@drawable/bg_glass_card"
                      android:padding="14dp"
                      android:layout_marginStart="6dp"
                      android:orientation="vertical"
                      android:gravity="center">
                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="Upload"
                          android:textColor="#64748B"
                          android:textSize="12sp" />
                      <LinearLayout
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:gravity="center_vertical"
                          android:layout_marginTop="6dp">
                          <TextView
                              android:layout_width="22dp"
                              android:layout_height="22dp"
                              android:background="@drawable/bg_circle_icon"
                              android:gravity="center"
                              android:text="↑"
                              android:textColor="#FACC15"
                              android:textSize="13sp"
                              android:textStyle="bold" />
                          <TextView
                              android:id="@+id/tvUploadSpeed"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="0.00"
                              android:textColor="#FFFFFF"
                              android:textSize="20sp"
                              android:textStyle="bold"
                              android:layout_marginStart="6dp" />
                          <TextView
                              android:id="@+id/tvUploadUnit"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text=" KB/S"
                              android:textColor="#64748B"
                              android:textSize="10sp"
                              android:layout_marginTop="3dp" />
                      </LinearLayout>
                  </LinearLayout>
              </LinearLayout>

              <!-- Center Glowing Multi-Layer Power Button -->
              <FrameLayout
                  android:layout_width="match_parent"
                  android:layout_height="0dp"
                  android:layout_weight="1">

                  <View
                      android:id="@+id/viewGlowHalo"
                      android:layout_width="265dp"
                      android:layout_height="265dp"
                      android:layout_gravity="center"
                      android:alpha="0.45"
                      android:background="@drawable/bg_outer_halo" />

                  <FrameLayout
                      android:layout_width="184dp"
                      android:layout_height="184dp"
                      android:layout_gravity="center"
                      android:background="@drawable/bg_power_ring">

                      <LinearLayout
                          android:id="@+id/btnConnect"
                          android:layout_width="154dp"
                          android:layout_height="154dp"
                          android:layout_gravity="center"
                          android:background="@drawable/bg_power_core"
                          android:orientation="vertical"
                          android:gravity="center"
                          android:clickable="true"
                          android:focusable="true">

                          <ImageView
                              android:layout_width="42dp"
                              android:layout_height="42dp"
                              android:src="@drawable/ic_power_white" />

                          <TextView
                              android:id="@+id/tvConnectLabel"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Connect"
                              android:textColor="#E0F2FE"
                              android:textSize="13sp"
                              android:textStyle="bold"
                              android:layout_marginTop="6dp" />
                      </LinearLayout>
                  </FrameLayout>
              </FrameLayout>

              <!-- Pill Server Selector Bar with Flag, IP, Signal Bars & Ping -->
              <LinearLayout
                  android:id="@+id/serverSelectorCard"
                  android:layout_width="match_parent"
                  android:layout_height="64dp"
                  android:background="@drawable/bg_pill_capsule"
                  android:paddingStart="12dp"
                  android:paddingEnd="18dp"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="14dp">

                  <TextView
                      android:id="@+id/tvFlag"
                      android:layout_width="42dp"
                      android:layout_height="42dp"
                      android:background="@drawable/bg_circle_icon"
                      android:gravity="center"
                      android:text="🇧🇩"
                      android:textSize="22sp" />

                  <LinearLayout
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical"
                      android:layout_marginStart="12dp">

                      <TextView
                          android:id="@+id/tvServerName"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="Bangladesh"
                          android:textColor="#FFFFFF"
                          android:textSize="15sp"
                          android:textStyle="bold" />

                      <TextView
                          android:id="@+id/tvServerIp"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="IP: 103.108.140.15"
                          android:textColor="#64748B"
                          android:textSize="11sp"
                          android:layout_marginTop="2dp" />
                  </LinearLayout>

                  <ImageView
                      android:layout_width="22dp"
                      android:layout_height="16dp"
                      android:src="@drawable/ic_signal_bars"
                      android:layout_marginEnd="8dp" />

                  <TextView
                      android:id="@+id/tvPing"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="18ms"
                      android:textColor="#94A3B8"
                      android:textSize="12sp"
                      android:layout_marginEnd="10dp" />

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text=">"
                      android:textColor="#94A3B8"
                      android:textSize="16sp"
                      android:textStyle="bold" />
              </LinearLayout>

              <!-- Bottom Capsule Navigation Bar with 4 Circular Icons -->
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="62dp"
                  android:background="@drawable/bg_pill_capsule"
                  android:paddingStart="10dp"
                  android:paddingEnd="10dp"
                  android:orientation="horizontal"
                  android:gravity="center"
                  android:weightSum="4">

                  <FrameLayout
                      android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1">
                      <TextView
                          android:id="@+id/navHome"
                          android:layout_width="46dp"
                          android:layout_height="46dp"
                          android:layout_gravity="center"
                          android:background="@drawable/bg_circle_active"
                          android:gravity="center"
                          android:text="⌂"
                          android:textColor="#00B4D8"
                          android:textSize="22sp" />
                  </FrameLayout>

                  <FrameLayout
                      android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1">
                      <TextView
                          android:id="@+id/navSpeed"
                          android:layout_width="46dp"
                          android:layout_height="46dp"
                          android:layout_gravity="center"
                          android:background="@drawable/bg_circle_icon"
                          android:gravity="center"
                          android:text="⚡"
                          android:textColor="#94A3B8"
                          android:textSize="18sp" />
                  </FrameLayout>

                  <FrameLayout
                      android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1">
                      <TextView
                          android:id="@+id/navServers"
                          android:layout_width="46dp"
                          android:layout_height="46dp"
                          android:layout_gravity="center"
                          android:background="@drawable/bg_circle_icon"
                          android:gravity="center"
                          android:text="🌐"
                          android:textColor="#94A3B8"
                          android:textSize="18sp" />
                  </FrameLayout>

                  <FrameLayout
                      android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1">
                      <TextView
                          android:id="@+id/navKillSwitch"
                          android:layout_width="46dp"
                          android:layout_height="46dp"
                          android:layout_gravity="center"
                          android:background="@drawable/bg_circle_icon"
                          android:gravity="center"
                          android:text="🛡"
                          android:textColor="#94A3B8"
                          android:textSize="18sp" />
                  </FrameLayout>
              </LinearLayout>

          </LinearLayout>
          EOF

          cat << 'EOF' > app/src/main/java/com/skumar/nexusvpn/NexusVpnService.java
          package com.skumar.nexusvpn;

          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.net.VpnService;
          import android.os.ParcelFileDescriptor;
          import java.io.IOException;
          import java.util.HashSet;
          import java.util.Set;

          public class NexusVpnService extends VpnService {
              private ParcelFileDescriptor vpnInterface = null;
              public static boolean isRunning = false;
              public static long startTimeMillis = 0;

              @Override
              public int onStartCommand(Intent intent, int flags, int startId) {
                  if (intent != null && "STOP".equals(intent.getAction())) {
                      stopVpn();
                      return START_NOT_STICKY;
                  }
                  startVpn();
                  return START_STICKY;
              }

              private void startVpn() {
                  if (vpnInterface != null) return;
                  try {
                      SharedPreferences prefs = getSharedPreferences("NexusPrefs", MODE_PRIVATE);
                      boolean adBlockEnabled = prefs.getBoolean("adblock", true);
                      boolean killSwitchEnabled = prefs.getBoolean("killswitch", false);
                      Set<String> bypassedApps = prefs.getStringSet("bypassed_apps", new HashSet<>());

                      Builder builder = new Builder();
                      builder.setSession("NEXUS VPN")
                             .setMtu(1420)
                             .addAddress("10.0.0.2", 32)
                             .addRoute("0.0.0.0", 0);

                      if (adBlockEnabled) {
                          builder.addDnsServer("94.140.14.14");
                          builder.addDnsServer("94.140.15.15");
                      } else {
                          builder.addDnsServer("1.1.1.1");
                          builder.addDnsServer("1.0.0.1");
                      }

                      if (killSwitchEnabled) {
                          builder.setBlocking(true);
                      }

                      for (String packageName : bypassedApps) {
                          try {
                              builder.addDisallowedApplication(packageName);
                          } catch (Exception ignored) {}
                      }

                      vpnInterface = builder.establish();
                      isRunning = true;
                      startTimeMillis = System.currentTimeMillis();
                  } catch (Exception e) {
                      e.printStackTrace();
                  }
              }

              private void stopVpn() {
                  try {
                      if (vpnInterface != null) {
                          vpnInterface.close();
                          vpnInterface = null;
                      }
                  } catch (IOException e) {
                      e.printStackTrace();
                  }
                  isRunning = false;
                  startTimeMillis = 0;
                  stopSelf();
              }

              @Override
              public void onDestroy() {
                  stopVpn();
                  super.onDestroy();
              }
          }
          EOF

          cat << 'EOF' > app/src/main/java/com/skumar/nexusvpn/MainActivity.java
          package com.skumar.nexusvpn;

          import android.app.Activity;
          import android.app.AlertDialog;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.content.pm.ApplicationInfo;
          import android.content.pm.PackageManager;
          import android.net.TrafficStats;
          import android.net.VpnService;
          import android.os.Bundle;
          import android.os.Handler;
          import android.os.Looper;
          import android.view.View;
          import android.widget.LinearLayout;
          import android.widget.TextView;
          import android.widget.Toast;
          import androidx.appcompat.app.AppCompatActivity;
          import java.util.ArrayList;
          import java.util.HashSet;
          import java.util.List;
          import java.util.Locale;
          import java.util.Random;
          import java.util.Set;

          public class MainActivity extends AppCompatActivity {
              private static final int VPN_REQUEST_CODE = 101;
              private TextView tvStatus, tvTimer, tvDownloadSpeed, tvDownloadUnit, tvUploadSpeed, tvUploadUnit;
              private TextView tvFlag, tvServerName, tvServerIp, tvPing, tvConnectLabel;
              private TextView btnAdBlock, btnSplitTunnel, navKillSwitch, navServers, navSpeed;
              private View viewGlowHalo;
              private LinearLayout btnConnect;
              private SharedPreferences prefs;

              private final Handler handler = new Handler(Looper.getMainLooper());
              private long lastRxBytes = 0;
              private long lastTxBytes = 0;

              private final String[][] serverList = {
                  {"🇧🇩", "Bangladesh", "103.108.140.15", "18ms"},
                  {"🇮🇳", "India (Mumbai)", "103.21.244.8", "24ms"},
                  {"🇮🇳", "India (New Delhi)", "103.224.241.19", "29ms"},
                  {"🇸🇬", "Singapore", "172.67.182.9", "32ms"},
                  {"🇺🇸", "United States", "185.23.12.163", "85ms"},
                  {"🇺🇸", "USA (Los Angeles)", "172.67.140.33", "115ms"},
                  {"🇬🇧", "United Kingdom", "172.64.155.20", "95ms"},
                  {"🇩🇪", "Germany", "188.114.96.3", "92ms"},
                  {"🇯🇵", "Japan", "104.26.10.78", "68ms"},
                  {"🇰🇷", "South Korea", "175.45.176.12", "72ms"},
                  {"🇦🇪", "UAE (Dubai)", "185.151.204.10", "55ms"},
                  {"🇸🇦", "Saudi Arabia", "212.138.112.44", "62ms"},
                  {"🇶🇦", "Qatar", "178.152.200.18", "58ms"},
                  {"🇲🇾", "Malaysia", "103.6.196.21", "38ms"},
                  {"🇮🇩", "Indonesia", "103.147.154.9", "44ms"},
                  {"🇹🇭", "Thailand", "103.253.72.14", "41ms"},
                  {"🇻🇳", "Vietnam", "103.1.238.55", "47ms"},
                  {"🇵🇭", "Philippines", "103.106.168.12", "53ms"},
                  {"🇭🇰", "Hong Kong", "103.243.176.90", "45ms"},
                  {"🇹🇼", "Taiwan", "103.124.72.31", "49ms"},
                  {"🇨🇦", "Canada", "192.99.148.66", "115ms"},
                  {"🇦🇺", "Australia", "103.246.250.11", "88ms"},
                  {"🇳🇿", "New Zealand", "103.231.90.42", "96ms"},
                  {"🇫🇷", "France", "185.16.44.71", "94ms"},
                  {"🇳🇱", "Netherlands", "185.107.56.88", "91ms"},
                  {"🇨🇭", "Switzerland", "185.156.46.19", "97ms"},
                  {"🇮🇹", "Italy", "185.229.236.50", "99ms"},
                  {"🇪🇸", "Spain", "185.253.152.33", "103ms"},
                  {"🇸🇪", "Sweden", "185.213.154.67", "105ms"},
                  {"🇳🇴", "Norway", "185.125.168.24", "108ms"},
                  {"🇫🇮", "Finland", "95.216.144.82", "104ms"},
                  {"🇩🇰", "Denmark", "185.10.220.15", "101ms"},
                  {"🇵🇱", "Poland", "185.208.164.39", "98ms"},
                  {"🇹🇷", "Turkey", "185.122.202.74", "78ms"},
                  {"🇷🇺", "Russia", "185.177.94.12", "85ms"},
                  {"🇺🇦", "Ukraine", "185.233.116.48", "90ms"},
                  {"🇧🇷", "Brazil", "177.54.148.22", "165ms"},
                  {"🇦🇷", "Argentina", "190.210.180.14", "178ms"},
                  {"🇲🇽", "Mexico", "187.188.164.51", "142ms"},
                  {"🇨🇱", "Chile", "200.73.112.38", "182ms"},
                  {"🇨🇴", "Colombia", "190.85.140.29", "158ms"},
                  {"🇿🇦", "South Africa", "196.244.192.63", "148ms"},
                  {"🇪🇬", "Egypt", "197.45.128.19", "89ms"},
                  {"🇳🇬", "Nigeria", "197.210.64.81", "154ms"},
                  {"🇰🇪", "Kenya", "196.201.214.35", "136ms"},
                  {"🇵🇰", "Pakistan", "103.255.4.77", "46ms"},
                  {"🇱🇰", "Sri Lanka", "103.247.192.18", "39ms"},
                  {"🇳🇵", "Nepal", "103.69.124.52", "34ms"},
                  {"🇮🇪", "Ireland", "185.111.212.40", "96ms"},
                  {"🇦🇹", "Austria", "185.181.60.27", "95ms"},
                  {"🇧🇪", "Belgium", "185.162.248.16", "93ms"},
                  {"🇵🇹", "Portugal", "185.113.140.61", "107ms"},
                  {"🇬🇷", "Greece", "185.138.42.84", "86ms"},
                  {"🇷🇴", "Romania", "185.146.84.23", "87ms"},
                  {"🇨🇿", "Czech Republic", "185.184.252.49", "94ms"}
              };
              private int selectedServerIndex = 0;

              @Override
              protected void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  setContentView(R.layout.activity_main);

                  prefs = getSharedPreferences("NexusPrefs", MODE_PRIVATE);

                  tvStatus = findViewById(R.id.tvStatus);
                  tvTimer = findViewById(R.id.tvTimer);
                  tvDownloadSpeed = findViewById(R.id.tvDownloadSpeed);
                  tvDownloadUnit = findViewById(R.id.tvDownloadUnit);
                  tvUploadSpeed = findViewById(R.id.tvUploadSpeed);
                  tvUploadUnit = findViewById(R.id.tvUploadUnit);
                  tvFlag = findViewById(R.id.tvFlag);
                  tvServerName = findViewById(R.id.tvServerName);
                  tvServerIp = findViewById(R.id.tvServerIp);
                  tvPing = findViewById(R.id.tvPing);
                  tvConnectLabel = findViewById(R.id.tvConnectLabel);
                  viewGlowHalo = findViewById(R.id.viewGlowHalo);

                  btnConnect = findViewById(R.id.btnConnect);
                  btnAdBlock = findViewById(R.id.btnAdBlock);
                  btnSplitTunnel = findViewById(R.id.btnSplitTunnel);
                  navKillSwitch = findViewById(R.id.navKillSwitch);
                  navServers = findViewById(R.id.navServers);
                  navSpeed = findViewById(R.id.navSpeed);
                  LinearLayout serverSelectorCard = findViewById(R.id.serverSelectorCard);

                  updateFeatureIcons();
                  updateServerDisplay();

                  btnConnect.setOnClickListener(v -> {
                      if (!NexusVpnService.isRunning) {
                          Intent intent = VpnService.prepare(this);
                          if (intent != null) {
                              startActivityForResult(intent, VPN_REQUEST_CODE);
                          } else {
                              onActivityResult(VPN_REQUEST_CODE, Activity.RESULT_OK, null);
                          }
                      } else {
                          Intent intent = new Intent(this, NexusVpnService.class);
                          intent.setAction("STOP");
                          startService(intent);
                          updateUIState(false);
                      }
                  });

                  btnAdBlock.setOnClickListener(v -> {
                      boolean current = prefs.getBoolean("adblock", true);
                      prefs.edit().putBoolean("adblock", !current).apply();
                      updateFeatureIcons();
                      Toast.makeText(this, !current ? "VIP AdGuard Ad-Blocker: ON" : "Ad-Blocker: OFF", Toast.LENGTH_SHORT).show();
                  });

                  navKillSwitch.setOnClickListener(v -> {
                      boolean current = prefs.getBoolean("killswitch", false);
                      prefs.edit().putBoolean("killswitch", !current).apply();
                      updateFeatureIcons();
                      Toast.makeText(this, !current ? "Kill Switch: ON" : "Kill Switch: OFF", Toast.LENGTH_SHORT).show();
                  });

                  btnSplitTunnel.setOnClickListener(v -> showSplitTunnelDialog());
                  serverSelectorCard.setOnClickListener(v -> showServerDialog());
                  navServers.setOnClickListener(v -> showServerDialog());

                  navSpeed.setOnClickListener(v -> {
                      int randomPing = 16 + new Random().nextInt(32);
                      tvPing.setText(randomPing + "ms");
                      Toast.makeText(this, "Fastest Ping: " + randomPing + "ms", Toast.LENGTH_SHORT).show();
                  });

                  lastRxBytes = TrafficStats.getTotalRxBytes();
                  lastTxBytes = TrafficStats.getTotalTxBytes();
                  handler.post(statsRunnable);
              }

              private void showServerDialog() {
                  String[] names = new String[serverList.length];
                  for (int i = 0; i < serverList.length; i++) {
                      names[i] = serverList[i][0] + "  " + serverList[i][1] + "  (" + serverList[i][3] + ")";
                  }
                  new AlertDialog.Builder(this)
                      .setTitle("Select Server (55 Countries)")
                      .setItems(names, (dialog, which) -> {
                          selectedServerIndex = which;
                          updateServerDisplay();
                      })
                      .show();
              }

              private void showSplitTunnelDialog() {
                  PackageManager pm = getPackageManager();
                  List<ApplicationInfo> apps = pm.getInstalledApplications(PackageManager.GET_META_DATA);
                  List<String> appNames = new ArrayList<>();
                  List<String> appPackages = new ArrayList<>();
                  Set<String> bypassed = new HashSet<>(prefs.getStringSet("bypassed_apps", new HashSet<>()));

                  for (ApplicationInfo app : apps) {
                      if (pm.getLaunchIntentForPackage(app.packageName) != null && !app.packageName.equals(getPackageName())) {
                          appNames.add(pm.getApplicationLabel(app).toString());
                          appPackages.add(app.packageName);
                      }
                  }

                  boolean[] checkedItems = new boolean[appPackages.size()];
                  for (int i = 0; i < appPackages.size(); i++) {
                      checkedItems[i] = bypassed.contains(appPackages.get(i));
                  }

                  new AlertDialog.Builder(this)
                      .setTitle("Split Tunneling (Bypass VPN)")
                      .setMultiChoiceItems(appNames.toArray(new String[0]), checkedItems, (dialog, which, isChecked) -> {
                          if (isChecked) bypassed.add(appPackages.get(which));
                          else bypassed.remove(appPackages.get(which));
                      })
                      .setPositiveButton("Save", (dialog, which) -> {
                          prefs.edit().putStringSet("bypassed_apps", bypassed).apply();
                          Toast.makeText(this, "Split Tunneling Updated!", Toast.LENGTH_SHORT).show();
                      })
                      .setNegativeButton("Cancel", null)
                      .show();
              }

              private void updateServerDisplay() {
                  tvFlag.setText(serverList[selectedServerIndex][0]);
                  tvServerName.setText(serverList[selectedServerIndex][1]);
                  tvServerIp.setText("IP: " + serverList[selectedServerIndex][2]);
                  tvPing.setText(serverList[selectedServerIndex][3]);
              }

              private void updateFeatureIcons() {
                  boolean adBlock = prefs.getBoolean("adblock", true);
                  boolean killSwitch = prefs.getBoolean("killswitch", false);
                  btnAdBlock.setAlpha(adBlock ? 1.0f : 0.4f);
                  navKillSwitch.setBackgroundResource(killSwitch ? R.drawable.bg_circle_active : R.drawable.bg_circle_icon);
              }

              @Override
              protected void onActivityResult(int requestCode, int resultCode, Intent data) {
                  super.onActivityResult(requestCode, resultCode, data);
                  if (requestCode == VPN_REQUEST_CODE && resultCode == Activity.RESULT_OK) {
                      Intent intent = new Intent(this, NexusVpnService.class);
                      startService(intent);
                      updateUIState(true);
                  }
              }

              private void updateUIState(boolean connected) {
                  if (connected) {
                      tvStatus.setText("Connected");
                      tvConnectLabel.setText("Disconnect");
                      viewGlowHalo.setAlpha(1.0f);
                  } else {
                      tvStatus.setText("Disconnected");
                      tvConnectLabel.setText("Connect");
                      viewGlowHalo.setAlpha(0.45f);
                      tvTimer.setText("00.00.00");
                  }
              }

              private final Runnable statsRunnable = new Runnable() {
                  @Override
                  public void run() {
                      long currentRx = TrafficStats.getTotalRxBytes();
                      long currentTx = TrafficStats.getTotalTxBytes();

                      long rxSpeed = Math.max(0, currentRx - lastRxBytes);
                      long txSpeed = Math.max(0, currentTx - lastTxBytes);
                      lastRxBytes = currentRx;
                      lastTxBytes = currentTx;

                      updateSpeedText(rxSpeed, tvDownloadSpeed, tvDownloadUnit);
                      updateSpeedText(txSpeed, tvUploadSpeed, tvUploadUnit);

                      if (NexusVpnService.isRunning && NexusVpnService.startTimeMillis > 0) {
                          updateUIState(true);
                          long elapsed = (System.currentTimeMillis() - NexusVpnService.startTimeMillis) / 1000;
                          long hrs = elapsed / 3600;
                          long mins = (elapsed % 3600) / 60;
                          long secs = elapsed % 60;
                          tvTimer.setText(String.format(Locale.US, "%02d.%02d.%02d", hrs, mins, secs));
                      }
                      handler.postDelayed(this, 1000);
                  }
              };

              private void updateSpeedText(long bytesPerSec, TextView numView, TextView unitView) {
                  if (bytesPerSec >= 1024 * 1024) {
                      numView.setText(String.format(Locale.US, "%.2f", bytesPerSec / (1024.0 * 1024.0)));
                      unitView.setText(" MB/S");
                  } else {
                      numView.setText(String.format(Locale.US, "%.2f", bytesPerSec / 1024.0));
                      unitView.setText(" KB/S");
                  }
              }
          }
          EOF

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5

      - name: Build Debug APK
        run: gradle assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NEXUS-VPN-PRO-APK
          path: app/build/outputs/apk/debug/app-debug.apk
